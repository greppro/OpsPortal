# 复制为 .env 后按需修改，docker compose 会自动读取同目录下的 .env。
# .env 里有密码和密钥，不要提交到仓库（已在 .gitignore 中忽略）。

# 首次启动时管理员 admin 的初始密码。留空则随机生成，并打印在后端日志里（只显示一次）。
ADMIN_PASSWORD=

# JWT 签名密钥，建议 32 位以上随机字符串，例如 openssl rand -hex 32 的输出。
# 留空则自动生成并保存在数据库里。
JWT_SECRET=

# 设置后，/metrics 和 /prometheus/targets 需要携带 Authorization: Bearer <METRICS_TOKEN>。
METRICS_TOKEN=

# 允许跨域访问后端接口的来源，逗号分隔，例如 https://a.example.com,https://b.example.com。
# 留空不开启跨域；前端通过同源反向代理访问时不需要设置。
CORS_ALLOW_ORIGINS=

# 内置可用性检测
PROBE_ENABLED=true
PROBE_INTERVAL=60s
PROBE_TIMEOUT=5s
PROBE_CONCURRENCY=10
# 内网自签证书检测失败时可以设为 true（会跳过所有地址的证书校验）
PROBE_INSECURE_SKIP_VERIFY=false
